# Database
DATABASE_URL="sqlite+aiosqlite:///./data/video-factory.db"

# Worker Service
WORKER_URL="http://127.0.0.1:8000"
API_TOKEN=""  # optional Bearer token for agent mutating calls
CORS_ORIGINS="*"

# Scheduler
ENABLE_SCHEDULER=1  # start APScheduler with the API process
SCHEDULER_AUTO_PUBLISH=0  # scheduled runs publish to ALL enabled accounts (use with care)

# Publishing
PUBLISH_REQUIRE_REVIEW=1  # only approved videos may be queued for publishing

# Queue backend: auto | db | redis
#   auto  = Redis if available, else run inline (simplest dev)
#   db    = Redis if available, else persist to generation_jobs for src.worker
QUEUE_BACKEND=auto
REDIS_URL=""

# AI Configuration (optional, can be set in UI)
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Fallback for LLM rewrite when no prompt provided
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
VERCEL_GATEWAY_API_KEY=""
VERCEL_GATEWAY_URL="https://ai-gateway.vercel.sh/v1"

# TTS — edge-tts defaults
TTS_VOICE="zh-CN-YunjianNeural"
TTS_RATE="+0%"

# Local TTS (OpenAI-compatible, e.g. Qwen3-TTS on :8883 or Spark-TTS on :8890)
# When set, local TTS takes precedence over edge-tts.
# Single-engine:
VLLM_TTS_URL=""
# High-quality Spark engine (takes precedence over VLLM_TTS_URL when set):
VLLM_TTS_HQ_URL=""
# Optional Spark voice library
# SPARK_VOICE_DIR=".data/connectors/voice"
# SPARK_VOICES_FILE="scripts/tts/spark-voices.json"
TTS_MODEL="tts-1"
TTS_LANGUAGE="Chinese"
TTS_SPEED=1.0
TTS_SAMPLE_RATE=16000
TTS_RESPONSE_FORMAT="wav"
TTS_TIMEOUT_S=300

# Material APIs (optional)
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Synthetic images via ComfyUI (OPTIONAL, OFF by default).
# WARNING: ComfyUI + SD3.5 can consume 10GB+ RAM/VRAM and has frozen laptops.
# Enable only on a machine with plenty of free memory. When disabled the
# pipeline always falls back to stock/local material or a placeholder.
ENABLE_SYNTHETIC=0
COMFYUI_URL="http://127.0.0.1:8188"
# Refuse to generate when free system RAM is below this (GB)
SYNTHETIC_MIN_FREE_GB=12
# Hard cap of images generated per call (keep this at 1 unless you know why)
SYNTHETIC_MAX_IMAGES=1
SYNTHETIC_TIMEOUT_S=120
SYNTHETIC_COOLDOWN_S=5

# Synthetic VIDEO / animation via ComfyUI (OPTIONAL, OFF by default).
# Even heavier than images (multi-GB video models, can take minutes per clip).
# Enable only on a capable GPU/high-memory host.
ENABLE_SYNTHETIC_VIDEO=0
# Optional: exported ComfyUI "workflow (API format)" JSON. Supports placeholders
# {{prompt}} {{negative}} {{width}} {{height}} {{length}} {{fps}} {{seed}} {{image}}
# When empty, a built-in LTX-Video text-to-video workflow is used.
SYNTHETIC_VIDEO_WORKFLOW=""
SYNTHETIC_VIDEO_MIN_FREE_GB=16
SYNTHETIC_VIDEO_MAX_CLIPS=2
SYNTHETIC_VIDEO_TIMEOUT_S=900
SYNTHETIC_VIDEO_FRAMES=97
SYNTHETIC_VIDEO_FPS=25
SYNTHETIC_VIDEO_WIDTH=768
SYNTHETIC_VIDEO_HEIGHT=512

# YouTube Data API (for auto-publish)
# Get credentials via Google Cloud Console OAuth: https://console.cloud.google.com/apis/credentials
# Store refresh token JSON in PublisherAccount.credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Video Settings
VIDEO_RESOLUTION="1080p"
VIDEO_FPS=30

# Series grouping
# 1: output under data/output/<series_slug>/<task_uuid>/
# 0: keep flat data/output/<task_uuid>/ (series tracked in DB only)
SERIES_OUTPUT_FOLDERS=1
# GNews (free tier ok for news image path)
GNEWS_API_KEY=
