# Database
DATABASE_URL="sqlite+aiosqlite:///./data/video-factory.db"

# Worker Service
WORKER_URL="http://127.0.0.1:8000"
API_TOKEN=""  # optional Bearer token for agent mutating calls
CORS_ORIGINS="*"

# AI Configuration (optional, can be set in UI)
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# TTS — edge-tts defaults
TTS_VOICE="zh-CN-XiaoxiaoNeural"
TTS_RATE="+0%"

# Local TTS (OpenAI-compatible, e.g. Qwen3-TTS on :8883 or Spark-TTS on :8890)
# When set, local TTS takes precedence over edge-tts.
# Single-engine:
VLLM_TTS_URL=""
# High-quality Spark engine (takes precedence over VLLM_TTS_URL when set):
VLLM_TTS_HQ_URL=""
# Optional Spark voice library
# SPARK_VOICE_DIR=".data/connectors/voice"
# SPARK_VOICES_FILE="scripts/tts/spark-voices.json"
TTS_MODEL="tts-1"
TTS_LANGUAGE="Chinese"
TTS_SPEED=1.0
TTS_SAMPLE_RATE=16000
TTS_RESPONSE_FORMAT="wav"
TTS_TIMEOUT_S=300

# Material APIs (optional)
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Video Settings
VIDEO_RESOLUTION="1080p"
VIDEO_FPS=30