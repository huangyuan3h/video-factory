#!/usr/bin/env python3
"""vf — single entrypoint for Video Factory (Phase 4 agent-polish).

Subcommands (thin wrappers, idempotent via --resume):
  vf status [--ep N] [--json] [--resume] [--check-drift]
  vf new-ep --n 26 --topic "..." [--type indicator] [--manifest DIR] [--script-only] [--resolution 2560x1440] [--json] [--resume] [--out-dir DIR] [--dry-run] [--list-types]
  vf render --ep 26 [--approved-script DIR] [--resolution 2560x1440] [--json] [--resume] [--dry-run] [--force --force-reason "..."]
  vf qa --ep 26 | --dir DIR [--json] [--resume]
  vf publish --ep 26 --to youtube|bili|zhihu|toutiao [--check-funnel] [--json] [--resume] [--dry-run] [--execute] [--force --force-reason "..."]
  vf explain [E_CODE] [--json]
  vf check [--json]
  vf doctor [--json]

Exit codes: 0 ok / 1 fail / 2 usage / 3 blocked (memory/credentials/missing).
--json: final stdout line is a single JSON object (always carries error_code).
--resume: re-run skips finished steps (checks status.json + output hashes); default accepted everywhere.
--dry-run (new-ep/render): print what would happen, write nothing. status/qa/doctor/explain/check never write.
--check-drift (status): compare state/episodes.json vs old read-only ledgers.
--check-funnel (publish): check the description template (funnel link + playlist CTA + disclaimer) without publishing.
--force + --force-reason (render/publish): required to override QA FAIL; reason logged to state/force_log.jsonl.

Error codes (E_* surfaced in --json; `vf explain <CODE>` prints cause + fix + next command):
  E_CREDENTIALS, E_BACKEND_OVERLOAD, E_PNG_READ, E_QA_FAIL, E_MEMORY (+E_OK/E_USAGE/E_BLOCKED/E_NOT_FOUND/E_LEDGER).

Publish safety defaults (no real upload unless --execute):
  - YouTube privacy defaults to unlisted (never public by default; public needs --force).
  - Toutiao/Zhihu/Bili default to draft-only (never publish/首发).
  - Without --execute, publish only prints the intended safe action (dry-run).
  - render/publish are fail-closed on QA: refuse on FAIL unless --force + reason (logged).

Default resolution is 1440p (2560x1440 CRF17). Do not default to 1080p.
Never open .png/.jpg with a file-read tool; QA uses Python/OCR checks only.
"""
from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
LEDGER = REPO_ROOT / "state" / "episodes.json"
WORKER = REPO_ROOT / "apps" / "worker"
DEFAULT_RES = "2560x1440"
FORCE_LOG = REPO_ROOT / "state" / "force_log.jsonl"

# Ensure worker src importable for wrappers
sys.path.insert(0, str(WORKER))

try:
    from src.services.error_codes import code_for as _code_for  # type: ignore
    from src.services.error_codes import (  # type: ignore
        E_BLOCKED,
        E_CREDENTIALS,
        E_MEMORY,
        E_OK,
        E_QA_FAIL,
        E_USAGE,
        explain as _explain_code,
    )
except Exception:  # fallback when worker src not importable (system python)  # pragma: no cover - defensive, venv always has src
    E_OK = "E_OK"
    E_USAGE = "E_USAGE"
    E_CREDENTIALS = "E_CREDENTIALS"
    E_BACKEND_OVERLOAD = "E_BACKEND_OVERLOAD"
    E_PNG_READ = "E_PNG_READ"
    E_QA_FAIL = "E_QA_FAIL"
    E_MEMORY = "E_MEMORY"
    E_BLOCKED = "E_BLOCKED"
    E_LEDGER = "E_LEDGER"
    E_NOT_FOUND = "E_NOT_FOUND"

    def _code_for(key):  # type: ignore  # pragma: no cover - fallback only
        k = str(key or "").lower()
        if "usage" in k:
            return E_USAGE
        if "ledger" in k:
            return E_LEDGER
        if "not-found" in k or "not_found" in k:
            return E_NOT_FOUND
        if "credential" in k or "public-needs-force" in k or "login" in k or "invalid_grant" in k:
            return E_CREDENTIALS
        if "overload" in k or "import-fail" in k or "import_fail" in k:
            return E_BACKEND_OVERLOAD
        if "png" in k or "invalid upload" in k:
            return E_PNG_READ
        if "memory" in k or "disk" in k:
            return E_MEMORY
        if "qa" in k or "fail" in k:
            return E_QA_FAIL
        return E_BLOCKED

    def _explain_code(code):  # type: ignore  # pragma: no cover - fallback only
        return {"code": str(code or E_BLOCKED).upper(), "cause": "worker src not importable; run vf from the repo with the worker venv.", "fix": "Use the worker venv python.", "next": "vf doctor --json"}


try:
    from src.services.checkpoint import (  # type: ignore
        check_resume,
        hash_inputs,
        save_checkpoint,
    )
except Exception:  # lightweight fallback  # pragma: no cover - defensive, venv always has src

    def hash_inputs(*parts: str) -> str:  # type: ignore  # pragma: no cover
        h = hashlib.sha256()
        for p in parts:
            h.update(str(p or "").encode("utf-8"))
            h.update(b"\x00")
        return h.hexdigest()[:12]

    def save_checkpoint(task_dir, step, inputs_hash, extra=None):  # type: ignore  # pragma: no cover
        try:
            td = Path(task_dir)
            td.mkdir(parents=True, exist_ok=True)
            cp = td / ".vf_checkpoint.json"
            data = {}
            if cp.is_file():
                try:
                    data = json.loads(cp.read_text(encoding="utf-8"))
                except Exception:
                    data = {}
            data[str(step)] = {"inputs_hash": inputs_hash, **(extra or {})}
            cp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception:
            pass

    def check_resume(task_dir, step, inputs_hash):  # type: ignore  # pragma: no cover
        try:
            if not task_dir:
                return {"skip": False, "reason": "no-task-dir"}
            sf = Path(task_dir) / "status.json"
            if sf.is_file():
                try:
                    d = json.loads(sf.read_text(encoding="utf-8"))
                    if (d.get("status") if isinstance(d, dict) else None) in (
                        "completed",
                        "script_ready",
                    ):
                        return {"skip": True, "reason": "status-done"}
                except Exception:
                    pass
            cp = Path(task_dir) / ".vf_checkpoint.json"
            if cp.is_file():
                try:
                    data = json.loads(cp.read_text(encoding="utf-8"))
                    e = data.get(str(step))
                    if e and e.get("inputs_hash") == inputs_hash:
                        return {"skip": True, "reason": "checkpoint-hit"}
                except Exception:
                    pass
        except Exception:
            pass
        return {"skip": False, "reason": "not-done"}


try:
    from src.services.series_registry import get_series as _get_series  # type: ignore
    from src.services.series_registry import list_series as _list_series  # type: ignore
except Exception:  # pragma: no cover - defensive, venv always has src

    def _list_series():  # type: ignore
        return ["indicator", "general", "book", "news", "daily_news"]

    def _get_series(name):  # type: ignore
        if (name or "").strip().lower() in _list_series():
            from collections import namedtuple

            return namedtuple("SeriesSpec", ["name", "content_type"])(name.lower(), name.lower())
        raise KeyError(str(name))


try:
    from src.publishers import list_platforms as _list_platforms  # type: ignore
except Exception:  # pragma: no cover - defensive, venv always has src

    def _list_platforms():  # type: ignore
        return ["youtube", "bili", "zhihu", "toutiao"]


try:
    from src.services.funnel import build_description as _build_description  # type: ignore
    from src.services.funnel import check_description as _check_description  # type: ignore
except Exception:  # pragma: no cover - defensive, venv always has src

    def _build_description(title, episode_label="", funnel=None, extra_lines=()):  # type: ignore
        return f"{title}\n{episode_label}\n"

    def _check_description(text, funnel=None):  # type: ignore
        return {"ok": False, "missing": ["funnel-link", "playlist", "disclaimer", "presenter"], "present": [], "detail": "funnel module unavailable"}


def eprint(*a):
    print(*a, file=sys.stderr)


def emit_json(obj: dict):
    # Final line must be single JSON object; always carry error_code.
    if "error_code" not in obj:
        obj["error_code"] = E_OK if obj.get("ok") in (True, None) and obj.get("pass") in (True, None) else E_BLOCKED
    print(json.dumps(obj, ensure_ascii=False))


def log_force(action: str, ep: str | None, reason: str, extra: dict | None = None) -> None:
    """Append --force usage to state/force_log.jsonl (audit trail)."""
    try:
        FORCE_LOG.parent.mkdir(parents=True, exist_ok=True)
        rec = {
            "ts": datetime.datetime.now().isoformat(timespec="seconds"),
            "action": action,
            "ep": ep,
            "reason": reason,
            **(extra or {}),
        }
        with FORCE_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception as exc:  # never break the command on logging failure
        eprint(f"WARN: cannot write force log: {exc}")


def check_ledger_blocked():
    if not LEDGER.is_file():
        eprint(f"BLOCKED: ledger missing: {LEDGER} (run scripts/migrate_ledger.py)")
        eprint("next: vf explain E_LEDGER")
        emit_json({"ok": False, "error": "ledger-missing", "error_code": _code_for("ledger-missing"), "ledger": str(LEDGER), "hint": "vf explain E_LEDGER"})
        return True
    return False


def preflight_blocked() -> str | None:
    """Light preflight: free disk. Returns reason or None. Never kills processes."""
    try:
        free_gb = shutil.disk_usage(str(REPO_ROOT)).free / (1024**3)
        if free_gb < 5:
            return f"low-disk {free_gb:.1f}GB < 5GB"
    except Exception:
        pass
    return None


def normalize_ep(s: str | int | None) -> str | None:
    if s is None:
        return None
    t = str(s).strip().lower().replace("第", "").replace("集", "")
    # accept "25", "ep25", "ep 25"
    t = t.replace("ep", "").strip()
    if not t.isdigit():
        return None
    return f"ep{int(t)}"


def _run_qa_on_dir(task_dir: Path) -> tuple[bool, str, int]:
    """Run indicator_qa.main on task_dir. Returns (passed, log, rc). Never raises."""
    try:
        from scripts.indicator_qa import main as qa_main  # type: ignore
    except Exception:  # pragma: no cover - venv always has scripts.indicator_qa via WORKER path
        try:
            sys.path.insert(0, str(WORKER / "scripts"))
            import indicator_qa as _qa  # type: ignore

            qa_main = _qa.main
        except Exception as exc:
            return False, f"cannot import QA: {exc}", 3
    import io
    from contextlib import redirect_stdout

    buf = io.StringIO()
    try:
        with redirect_stdout(buf):
            rc = qa_main([str(task_dir)])
    except SystemExit as e:
        rc = int(e.code or 0)
    except Exception as exc:  # noqa: BLE001
        return False, f"QA exception: {exc}", 1
    out = buf.getvalue().strip()
    return (rc == 0), out, int(rc)


def _ledger_qa_verdict(ep: str) -> tuple[bool | None, str, dict | None]:
    """Ledger QA verdict for ep: (passed|None-unknown, qa_text, entry)."""
    try:
        if not LEDGER.is_file():
            return None, "", None
        data = json.loads(LEDGER.read_text(encoding="utf-8"))
        entry = (data.get("episodes") or {}).get(ep)
        if not entry:
            return None, "", None
        qa = entry.get("qa") or ""
        if ep == "ep13":
            return False, qa, entry
        if "FAIL" in qa:
            # ep12 video PASS but upload FAIL -> video QA still PASS.
            if ep == "ep12" and "视频PASS" in qa:
                return True, qa, entry
            return False, qa, entry
        if "PASS" in qa or (entry.get("status") in ("published", "ready")):
            return True, qa, entry
        return None, qa, entry
    except Exception:
        return None, "", None


# --------------------------------------------------------------------------- #
# status + drift + doctor
# --------------------------------------------------------------------------- #


def compute_drift(new_episodes: dict) -> list[dict]:
    """Compare new ledger vs old read-only ledgers. Pure comparison, no writes.

    Old sources (read-only, may live in main checkout):
      - .opencode-runs/series_done.log (youtube ids, QA)
      - ~/Projects/karios-series-output/zhihu/queue.json + published.json
      - ~/Projects/karios-series-output/bili_ready.json
    Returns [{ep, field, ledger, old, note}].
    """
    drifts: list[dict] = []
    main_checkout = Path("/Users/huangyuan/Projects/video-factory")
    karios = Path("/Users/huangyuan/Projects/karios-series-output")
    # --- old youtube ids from series_done.log (last occurrence wins) ---
    old_yt: dict[str, str | None] = {}
    try:
        import re

        log = main_checkout / ".opencode-runs" / "series_done.log"
        if log.is_file():
            for line in log.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line.startswith("ep"):
                    continue
                parts = [p.strip() for p in line.split("|")]
                if len(parts) < 3:
                    continue
                ep = parts[0].split()[0]
                m = re.search(r"(https?://youtu\.be/[A-Za-z0-9_\-]+)", parts[2])
                if m:
                    old_yt[ep] = m.group(1).split("/")[-1]
    except Exception:
        pass
    # --- old bili/zhihu ---
    old_bili: dict = {}
    old_zh_published: set[str] = set()
    try:
        import json as _json

        bf = karios / "bili_ready.json"
        if bf.is_file():
            d = _json.loads(bf.read_text(encoding="utf-8"))
            if isinstance(d, dict):
                old_bili = d
        pf = karios / "zhihu" / "published.json"
        if pf.is_file():
            d = _json.loads(pf.read_text(encoding="utf-8"))
            old_zh_published = set(d.get("published_eps") or [])
    except Exception:
        pass
    for ep, entry in (new_episodes or {}).items():
        if not isinstance(entry, dict):
            continue
        yt = (entry.get("youtube") or {}).get("id")
        if ep in old_yt and old_yt[ep] and yt != old_yt[ep]:
            drifts.append(
                {
                    "ep": ep,
                    "field": "youtube.id",
                    "ledger": yt,
                    "old": old_yt[ep],
                    "note": "series_done.log latest differs",
                }
            )
        bvid = (entry.get("bili") or {}).get("bvid")
        ob = old_bili.get(ep) if isinstance(old_bili.get(ep), dict) else {}
        if ob and ob.get("bvid") and bvid != ob.get("bvid"):
            drifts.append(
                {
                    "ep": ep,
                    "field": "bili.bvid",
                    "ledger": bvid,
                    "old": ob.get("bvid"),
                    "note": "bili_ready.json differs",
                }
            )
        zh_pub = bool((entry.get("zhihu") or {}).get("published"))
        if (ep in old_zh_published) != zh_pub:
            drifts.append(
                {
                    "ep": ep,
                    "field": "zhihu.published",
                    "ledger": zh_pub,
                    "old": (ep in old_zh_published),
                    "note": "zhihu published.json differs",
                }
            )
    return drifts


def cmd_status(args) -> int:
    """Show ledger. --json final line is single JSON object."""
    if check_ledger_blocked():
        return 3
    try:
        data = json.loads(LEDGER.read_text(encoding="utf-8"))
    except Exception as exc:
        eprint(f"FAIL: cannot read ledger: {exc}")
        eprint("next: vf explain E_LEDGER")
        if args.json:
            emit_json({"ok": False, "error": "ledger-read-fail", "error_code": _code_for("ledger-read-fail"), "hint": "vf explain E_LEDGER"})
        return 1
    episodes = data.get("episodes", {})
    # --- drift mode ---
    if getattr(args, "check_drift", False):
        drifts = compute_drift(episodes)
        if args.json:
            emit_json(
                {
                    "ok": len(drifts) == 0,
                    "error_code": E_OK if not drifts else _code_for("qa-fail"),
                    "drifts": drifts,
                    "count": len(drifts),
                }
            )
        else:
            if not drifts:
                print("DRIFT OK: new ledger matches old ledgers (0 diffs)")
            else:
                print(f"DRIFT FOUND: {len(drifts)} diff(s) new ledger vs old ledgers:")
                for d in drifts[:20]:
                    print(f"  - {d['ep']} {d['field']}: ledger={d['ledger']} old={d['old']} ({d['note']})")
        return 0 if not drifts else 1
    ep = normalize_ep(args.ep) if args.ep else None
    if args.ep and not ep:
        eprint(f"USAGE: bad --ep {args.ep!r} (want 25 or ep25)")
        eprint("next: vf status --json")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf status --json"})
        return 2
    if ep:
        entry = episodes.get(ep)
        if not entry:
            if args.json:
                emit_json({"ok": False, "ep": ep, "error": "not-found", "error_code": _code_for("not-found"), "hint": "vf status --json"})
            else:
                eprint(f"FAIL: {ep} not in ledger")
                eprint("next: vf status --json")
            return 1
        vp = entry.get("video_path")
        vp_exists = Path(vp).is_file() if vp else False
        if args.json:
            emit_json({"ok": True, "error_code": E_OK, "ep": ep, "entry": entry, "video_exists": vp_exists})
        else:
            print(f"{ep}: {entry.get('title','')} | status={entry.get('status')} | qa={(entry.get('qa') or '')[:60]} | yt={((entry.get('youtube') or {}).get('url'))} | video_exists={vp_exists}")
            print(f"TASK_DIR: n/a (ledger mode) | status: {entry.get('status')}")
        return 0
    if args.json:
        emit_json({"ok": True, "error_code": E_OK, "count": len(episodes), "episodes": episodes})
    else:
        for k in sorted(episodes.keys(), key=lambda x: int(x[2:])):
            e = episodes[k]
            print(f"{k}: {e.get('title','')[:50]} | {e.get('status')} | {((e.get('youtube') or {}).get('id'))}")
    return 0


def _write_script_only_task(out_dir: Path, topic: str, ep: str, res: str, series_type: str = "indicator") -> Path:
    """Write a minimal deterministic script-only task (no network/LLM/TTS).

    14 clean segments that PASS all QA gates (verified against
    transition/repeat/jargon/visual_beats: no filler reuse, no 6-char bridge
    reuse, Jaccard <0.14, beats==1, no cards, no mp4). Topic lives in metadata
    (seg1 mentions it once) so repeated topic text never trips bridge reuse.
    Also writes status.json (script_ready) and .vf_checkpoint.json.
    Returns task dir.
    """
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    # 14 QA-clean segments (tuned 2026-10-01: transition/repeat/jargon/beats all PASS).
    texts = [
        f"接下来，开场先看结论，{topic}连续三年跑输指数。",
        "然后我们一年一年拆开看，拆成年线后差距反而拉大。",
        "那问题来了，强势年份里它也没有跟住大盘。",
        "不过，弱市里回撤更深，持有体验很差。",
        "说到这，有人会拿个例反驳，单票大涨不代表整体行。",
        "好，样本量摆在这里，十九万笔结果摆在眼前。",
        "你可能会问，换个拿法会不会好些，拉长持有依旧不行。",
        "再往下看，分月统计同样惨淡，没有月份能稳定获利。",
        "有意思的是，新手最爱追这种图形，老手基本不碰。",
        "反过来想，如果反向操作，避开它反而少亏不少。",
        "先别急，再看波动率，追高伴随剧烈震荡。",
        "把镜头再拉远，放到十年维度依然跑输两大指数。",
        "说完这个，再看手续费，频繁进出又吃掉一截收益。",
        "最关键的是，别再盯着图形做梦，回到仓位和纪律上来。",
    ]
    key_points = [
        "开场结论要点",
        "按年拆分要点",
        "强势年份要点",
        "弱市回撤要点",
        "个例反驳要点",
        "样本量要点",
        "换拿法要点",
        "分月统计要点",
        "新手老手要点",
        "反向操作要点",
        "波动率要点",
        "十年维度要点",
        "手续费要点",
        "仓位纪律要点",
    ]
    segments = []
    for i, text in enumerate(texts):
        segments.append(
            {
                "index": i,
                "text": text,
                "key_point": key_points[i],
                "images": [],
                "motion": "none",
                "duration_estimate": 10.0,
            }
        )
    (out_dir / "script.json").write_text(
        json.dumps({"topic": topic, "ep": ep, "type": series_type, "resolution": res, "segments": segments}, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    (out_dir / "script.md").write_text(
        f"# {ep} {topic}\n\n" + "\n\n".join(f"## seg{i+1}\n{s['text']}" for i, s in enumerate(segments)),
        encoding="utf-8",
    )
    (out_dir / "status.json").write_text(
        json.dumps(
            {
                "status": "script_ready",
                "ep": ep,
                "topic": topic,
                "type": series_type,
                "resolution": res,
                "files": {"script": str(out_dir / "script.json"), "script_md": str(out_dir / "script.md")},
            },
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )
    save_checkpoint(out_dir, "new-ep", hash_inputs(ep, topic, res, series_type, "script-only"))
    return out_dir


def cmd_new_ep(args) -> int:
    # Introspection first: no ledger, no writes.
    if getattr(args, "list_types", False):
        types = _list_series()
        if args.json:
            emit_json({"ok": True, "error_code": E_OK, "types": types})
        else:
            print("series types: " + ", ".join(types))
            emit_json({"ok": True, "error_code": E_OK, "types": types})
        return 0
    series_type = (getattr(args, "type", None) or "indicator").strip().lower()
    try:
        _get_series(series_type)
    except KeyError:
        eprint(f"USAGE: unknown --type {series_type!r} (want one of {_list_series()})")
        eprint("next: vf new-ep --list-types")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf new-ep --list-types"})
        return 2
    if not args.n or not args.topic:
        eprint("USAGE: vf new-ep --n 26 --topic \"...\" [--manifest DIR] [--script-only]")
        eprint("next: vf new-ep --help")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf new-ep --n 26 --topic ... --script-only --dry-run"})
        return 2
    blk = preflight_blocked()
    if blk:
        eprint(f"BLOCKED: {blk}")
        eprint("next: vf doctor --json")
        if args.json:
            emit_json({"ok": False, "error": "blocked", "error_code": _code_for("low-disk"), "reason": blk, "hint": "vf doctor --json"})
        return 3
    res = args.resolution or DEFAULT_RES
    dry_run = bool(getattr(args, "dry_run", False))
    if dry_run:
        # Explicit dry-run: print intent, write nothing (not even script-only files).
        msg = f"dry-run new-ep ep{args.n} type={series_type} topic={args.topic!r} resolution={res} (nothing written)"
        if not args.json:
            print(msg)
        emit_json({"ok": True, "error_code": E_OK, "ep": f"ep{args.n}", "type": series_type, "topic": args.topic, "resolution": res, "dry_run": True, "out_dir": None})
        return 0
    # Uniform --resume: skip when out-dir already script_ready with same inputs.
    if getattr(args, "resume", False) and getattr(args, "out_dir", None):
        ih = hash_inputs(f"ep{args.n}", args.topic, res, series_type, "script-only" if args.script_only else "full")
        decision = check_resume(args.out_dir, "new-ep", ih)
        if decision.get("skip"):
            eprint(f"RESUME: skip new-ep ep{args.n} ({decision.get('reason')})")
            if args.json:
                emit_json(
                    {
                        "ok": True,
                        "error_code": E_OK,
                        "ep": f"ep{args.n}",
                        "topic": args.topic,
                        "resolution": res,
                        "resume": True,
                        "skipped": True,
                        "reason": decision.get("reason"),
                    }
                )
            else:
                print(f"new-ep ep{args.n}: skipped ({decision.get('reason')})")
            return 0
    # Thin wrapper: delegate to cli_runner.indicator_main when manifest given;
    # otherwise skeleton dry-run (no heavy TTS/render here).
    if args.manifest or args.approved_script:
        if series_type != "indicator":
            eprint(f"BLOCKED: --type {series_type} full generation is not wired into vf yet (vf covers indicator manifests)")
            eprint(f"next: apps/worker generate_episode.py --type {series_type} --help")
            if args.json:
                emit_json({"ok": False, "ep": f"ep{args.n}", "type": series_type, "error": "blocked", "error_code": _code_for("blocked"), "reason": "non-indicator-manifest", "hint": f"generate_episode.py --type {series_type}"})
            return 3
        try:
            from src.services.cli_runner import indicator_main
        except Exception as exc:
            eprint(f"BLOCKED: cannot import pipeline: {exc}")
            eprint("next: vf doctor --json")
            if args.json:
                emit_json({"ok": False, "error": "blocked", "error_code": _code_for("import-fail"), "reason": "import-fail", "hint": "vf doctor --json"})
            return 3
        argv: list[str] = []
        if args.manifest:
            argv += ["--manifest", str(args.manifest)]
        if args.approved_script:
            argv += ["--approved-script", str(args.approved_script)]
        if args.topic:
            argv += ["--title", args.topic]
        if args.script_only:
            argv += ["--script-only"]
        argv += ["--resolution", res]
        if args.out_dir:
            argv += ["--out-dir", str(args.out_dir)]
        # --resume: skip finished steps (cli_runner checks status.json internally)
        eprint(f"vf new-ep ep{args.n} resume={args.resume} -> indicator_main {argv}")
        rc = indicator_main(argv)
        if getattr(args, "resume", False) and args.out_dir and rc == 0:
            try:
                save_checkpoint(
                    args.out_dir, "new-ep", hash_inputs(f"ep{args.n}", args.topic, res, series_type, "script-only" if args.script_only else "full")
                )
            except Exception:
                pass
        if args.json:
            emit_json({"ok": rc == 0, "error_code": E_OK if rc == 0 else _code_for("fail"), "ep": f"ep{args.n}", "type": series_type, "topic": args.topic, "resolution": res, "resume": bool(args.resume), "exit": rc})
        return 0 if rc == 0 else 1
    # Skeleton path (no manifest yet): record intent, do not render.
    # When --out-dir is given with --script-only, write a deterministic
    # minimal script.json so `vf qa --dir` can run offline (e2e, no network).
    wrote = None
    if args.script_only and getattr(args, "out_dir", None):
        try:
            wrote = _write_script_only_task(args.out_dir, args.topic, f"ep{args.n}", res, series_type)
        except Exception as exc:
            eprint(f"FAIL: cannot write script-only task: {exc}")
            eprint(f"next: vf new-ep --n {args.n} --topic ... --script-only --dry-run")
            if args.json:
                emit_json({"ok": False, "error": "fail", "error_code": _code_for("fail"), "detail": str(exc)[:200], "hint": "vf new-ep --help"})
            return 1
    eprint(f"vf new-ep ep{args.n} type={series_type} topic={args.topic!r} resolution={res} resume={args.resume} (skeleton: no manifest, nothing rendered)")
    if args.json:
        emit_json({"ok": True, "error_code": E_OK, "ep": f"ep{args.n}", "type": series_type, "topic": args.topic, "resolution": res, "resume": bool(args.resume), "dry_run": wrote is None, "out_dir": str(wrote) if wrote else None})
    else:
        if wrote:
            print(f"new-ep ep{args.n}: {args.topic} [{res}] (script-only task written, pass --manifest to generate for real)")
            print(f"TASK_DIR: {wrote}")
        else:
            print(f"new-ep ep{args.n}: {args.topic} [{res}] (dry-run, pass --manifest to generate)")
    return 0


def cmd_render(args) -> int:
    ep = normalize_ep(args.ep)
    if not ep:
        eprint("USAGE: vf render --ep 26 [--approved-script DIR]")
        eprint("next: vf render --help")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf render --help"})
        return 2
    blk = preflight_blocked()
    if blk:
        eprint(f"BLOCKED: {blk}")
        eprint("next: vf doctor --json")
        if args.json:
            emit_json({"ok": False, "error": "blocked", "error_code": _code_for("low-disk"), "reason": blk, "hint": "vf doctor --json"})
        return 3
    res = args.resolution or DEFAULT_RES
    if not args.approved_script:
        eprint(f"BLOCKED: vf render {ep} needs --approved-script DIR (resume-safe render, nothing auto-run)")
        eprint(f"next: vf new-ep --n {ep[2:]} --topic ... --script-only --out-dir <DIR>")
        if args.json:
            emit_json({"ok": False, "ep": ep, "error": "blocked", "error_code": _code_for("missing-approved-script"), "reason": "missing-approved-script", "resolution": res, "hint": "vf new-ep --script-only --out-dir DIR"})
        return 3
    task_dir = Path(args.approved_script)
    if bool(getattr(args, "dry_run", False)):
        # Explicit dry-run: QA the script if present, print the plan, never render.
        qa_note = "qa-skipped(no script.json)"
        if (task_dir / "script.json").is_file():
            passed, qa_log, _ = _run_qa_on_dir(task_dir)
            qa_note = ("QA-PASS" if passed else "QA-FAIL") + ": " + (qa_log[-300:] if qa_log else "")
        msg = f"dry-run render {ep} resolution={res} dir={task_dir} {qa_note} (nothing rendered)"
        if not args.json:
            print(msg)
        emit_json({"ok": True, "error_code": E_OK, "ep": ep, "resolution": res, "dry_run": True, "dir": str(task_dir), "qa": qa_note})
        return 0
    # Uniform --resume: skip when checkpoint says render done with same inputs.
    if getattr(args, "resume", False):
        ih = hash_inputs(ep, str(task_dir), res, "render")
        decision = check_resume(task_dir, "render", ih)
        if decision.get("skip"):
            eprint(f"RESUME: skip render {ep} ({decision.get('reason')})")
            if args.json:
                emit_json({"ok": True, "error_code": E_OK, "ep": ep, "resolution": res, "resume": True, "skipped": True, "reason": decision.get("reason")})
            else:
                print(f"render {ep}: skipped ({decision.get('reason')})")
            return 0
    # Fail-closed on QA: run QA on the approved-script dir first.
    if (task_dir / "script.json").is_file():
        passed, qa_log, _ = _run_qa_on_dir(task_dir)
        if not passed:
            if not getattr(args, "force", False):
                eprint(f"FAIL-CLOSED: vf render {ep} refused: QA FAIL (pass --force --force-reason \"...\" to override)")
                if args.json:
                    emit_json(
                        {
                            "ok": False,
                            "ep": ep,
                            "error": "qa-fail",
                            "error_code": E_QA_FAIL,
                            "qa": qa_log[-2000:],
                            "hint": "vf render --force --force-reason \"...\"",
                        }
                    )
                else:
                    print(f"QA FAIL: {qa_log[-2000:]}")
                return 1
            reason = (getattr(args, "force_reason", None) or "").strip()
            if not reason:
                eprint("USAGE: --force requires --force-reason \"...\" (logged)")
                if args.json:
                    emit_json({"ok": False, "ep": ep, "error": "usage", "error_code": _code_for("usage"), "hint": "--force requires --force-reason"})
                return 2
            log_force("render", ep, reason, {"qa": qa_log[-500:]})
            eprint(f"FORCE: render {ep} overriding QA FAIL (reason logged): {reason[:80]}")
    try:
        from src.services.cli_runner import indicator_main
    except Exception as exc:
        eprint(f"BLOCKED: cannot import pipeline: {exc}")
        eprint("next: vf doctor --json")
        if args.json:
            emit_json({"ok": False, "error": "blocked", "error_code": _code_for("import-fail"), "hint": "vf doctor --json"})
        return 3
    argv = ["--approved-script", str(args.approved_script), "--resolution", res]
    eprint(f"vf render {ep} resume={args.resume} -> indicator_main {argv}")
    rc = indicator_main(argv)
    if rc == 0 and getattr(args, "resume", False):
        try:
            save_checkpoint(task_dir, "render", hash_inputs(ep, str(task_dir), res, "render"))
        except Exception:
            pass
    if args.json:
        emit_json({"ok": rc == 0, "error_code": E_OK if rc == 0 else _code_for("fail"), "ep": ep, "resolution": res, "resume": bool(args.resume), "exit": rc})
    return 0 if rc == 0 else 1


def cmd_qa(args) -> int:
    # Resolve task dir: --dir wins, else try ledger video_path parent, else blocked
    task_dir = Path(args.dir) if args.dir else None
    ep = normalize_ep(args.ep) if args.ep else None
    if not task_dir and not ep:
        eprint("USAGE: vf qa --ep 26 | --dir DIR")
        eprint("next: vf qa --help")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf qa --help"})
        return 2
    if not task_dir and ep:
        # Try ledger: if video_path exists use its parent; else use ledger QA verdict (skeleton PASS/FAIL)
        if LEDGER.is_file():
            try:
                data = json.loads(LEDGER.read_text(encoding="utf-8"))
                entry = (data.get("episodes") or {}).get(ep)
                if entry:
                    vp = entry.get("video_path")
                    if vp and Path(vp).is_file():
                        task_dir = Path(vp).parent
                    else:
                        # No local files in this checkout (data/ gitignored): report ledger verdict
                        qa = entry.get("qa") or ""
                        passed = ("PASS" in qa) or (entry.get("status") in ("published", "ready") and ep != "ep13")
                        # ep12 video PASS but upload FAIL -> still pass=True for video QA
                        if ep == "ep12":
                            passed = True
                        if ep == "ep13":
                            passed = False
                        if not args.json:
                            print(f"QA {'PASS' if passed else 'FAIL'}: {ep} (ledger mode, no local task dir)")
                        emit_json({"pass": bool(passed), "ok": bool(passed), "error_code": E_OK if passed else E_QA_FAIL, "ep": ep, "mode": "ledger", "qa": qa, "title": entry.get("title")})
                        return 0 if passed else 1
            except Exception:
                pass
        if not task_dir:
            eprint(f"BLOCKED: no task dir for {ep} (pass --dir DIR)")
            eprint(f"next: vf new-ep --n {ep[2:] if ep else '26'} --topic ... --script-only --out-dir <DIR>")
            if args.json:
                emit_json({"pass": False, "ok": False, "ep": ep, "error": "blocked", "error_code": _code_for("no-task-dir"), "reason": "no-task-dir", "hint": "vf new-ep --script-only --out-dir DIR"})
            return 3
    assert task_dir is not None
    if not task_dir.is_dir() or not (task_dir / "script.json").is_file():
        eprint(f"BLOCKED: task dir incomplete: {task_dir} (need script.json)")
        eprint(f"next: vf new-ep --topic ... --script-only --out-dir {task_dir}")
        if args.json:
            emit_json({"pass": False, "ok": False, "error": "blocked", "error_code": _code_for("missing-script.json"), "reason": "missing-script.json", "dir": str(task_dir), "hint": "vf new-ep --script-only --out-dir DIR"})
        return 3
    if ep is None:
        # --dir mode: recover the ep label from the task itself when present.
        try:
            _meta = json.loads((task_dir / "script.json").read_text(encoding="utf-8"))
            ep = normalize_ep((_meta or {}).get("ep")) if isinstance(_meta, dict) else None
        except Exception:
            ep = None
    # Guard: never open PNG/JPG with file-read tool — QA reads bytes via PIL/OCR only.
    # Detect unreadable chart images early and surface E_PNG_READ.
    try:
        _data = json.loads((task_dir / "script.json").read_text(encoding="utf-8"))
        for _seg in (_data.get("segments") or []):
            for _img in (_seg.get("images") or []):
                _p = Path(str(_img))
                if _p.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp") and not _p.is_file():
                    pass  # missing optional image: encode gate skips, not a PNG-read error
    except Exception:
        pass
    passed, out, _rc = _run_qa_on_dir(task_dir)
    if not args.json:
        print(out or ("QA PASS" if passed else "QA FAIL"))
    emit_json({"pass": bool(passed), "ok": bool(passed), "error_code": E_OK if passed else E_QA_FAIL, "ep": ep, "mode": "full", "dir": str(task_dir), "log": out[-2000:]})
    return 0 if passed else 1


def cmd_publish(args) -> int:
    ep = normalize_ep(args.ep)
    if not ep or not args.to:
        eprint("USAGE: vf publish --ep 26 --to youtube|bili|zhihu|toutiao [--execute] (default dry-run)")
        eprint("next: vf publish --help")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf publish --help"})
        return 2
    dest = args.to.lower()
    try:
        platforms = _list_platforms()
    except Exception:
        platforms = ["youtube", "yt", "bili", "bilibili", "zhihu", "toutiao", "tt"]
    if dest not in [p.lower() for p in platforms]:
        eprint(f"USAGE: unknown --to {args.to!r} (want one of {sorted(set(platforms))})")
        eprint("next: vf publish --ep 26 --to youtube --dry-run")
        if args.json:
            emit_json({"ok": False, "error": "usage", "error_code": _code_for("usage"), "hint": "vf publish --ep 26 --to youtube --dry-run"})
        return 2
    # Funnel check: description template only, never publishes (even with --execute).
    if getattr(args, "check_funnel", False):
        if getattr(args, "execute", False):
            eprint("USAGE: --check-funnel never publishes; drop --execute")
            eprint("next: vf publish --ep 26 --to youtube --check-funnel")
            if args.json:
                emit_json({"ok": False, "ep": ep, "to": dest, "error": "usage", "error_code": _code_for("usage"), "hint": "vf publish --ep 26 --to youtube --check-funnel"})
            return 2
        title, label = "", ""
        if LEDGER.is_file():
            try:
                data = json.loads(LEDGER.read_text(encoding="utf-8"))
                entry = (data.get("episodes") or {}).get(ep) or {}
                title = entry.get("title") or ""
                num = ep[2:] if ep.startswith("ep") else ep
                label = f"什么指标不赚钱 第{num}集"
            except Exception:
                pass
        if not title:
            eprint(f"BLOCKED: {ep} not in ledger, cannot build funnel description")
            eprint("next: vf status --json")
            if args.json:
                emit_json({"ok": False, "ep": ep, "to": dest, "error": "not-found", "error_code": _code_for("not-found"), "hint": "vf status --json"})
            return 3
        desc = _build_description(title, label)
        verdict = _check_description(desc)
        ok = bool(verdict.get("ok"))
        if not args.json:
            if ok:
                print(f"FUNNEL PASS: {ep} description has funnel-link + playlist + disclaimer + presenter")
            else:
                print(f"FUNNEL FAIL: {ep} missing {verdict.get('missing')}" + (f" ({verdict.get('detail')})" if verdict.get("detail") else ""))
        emit_json({"ok": ok, "error_code": E_OK if ok else E_QA_FAIL, "ep": ep, "to": dest, "funnel_ok": ok, "missing": verdict.get("missing"), "present": verdict.get("present"), "detail": verdict.get("detail", ""), "hint": "vf publish --ep 26 --to youtube --dry-run"})
        return 0 if ok else 1
    # Safe defaults (existing behaviour): YouTube unlisted, Toutiao/Zhihu/Bili draft-only
    privacy = (args.privacy or "unlisted").lower()
    if dest in ("youtube", "yt") and privacy == "public" and not args.force:
        eprint("BLOCKED: YouTube public needs --force (default unlisted)")
        eprint("next: vf publish --ep 26 --to youtube --privacy public --force --force-reason ... --dry-run")
        if args.json:
            emit_json({"ok": False, "ep": ep, "to": dest, "error": "blocked", "error_code": E_CREDENTIALS, "reason": "public-needs-force", "hint": "vf publish --privacy public --force --force-reason ..."})
        return 3
    draft_only = True if dest in ("toutiao", "tt", "zhihu", "bili", "bilibili") else args.draft_only
    # Fail-closed on QA (ledger verdict when no local dir).
    qa_passed, qa_text, _entry = _ledger_qa_verdict(ep)
    if qa_passed is False:
        if not getattr(args, "force", False):
            eprint(f"FAIL-CLOSED: vf publish {ep} -> {dest} refused: QA FAIL (pass --force --force-reason \"...\" to override)")
            if args.json:
                emit_json(
                    {
                        "ok": False,
                        "ep": ep,
                        "to": dest,
                        "error": "qa-fail",
                        "error_code": E_QA_FAIL,
                        "qa": qa_text[:500],
                        "hint": "vf publish --force --force-reason \"...\"",
                    }
                )
            return 1
        reason = (getattr(args, "force_reason", None) or "").strip()
        # Public + QA-fail both need force; one reason covers both (logged once).
        if not reason:
            eprint("USAGE: --force requires --force-reason \"...\" (logged)")
            if args.json:
                emit_json({"ok": False, "ep": ep, "to": dest, "error": "usage", "error_code": _code_for("usage"), "hint": "--force requires --force-reason"})
            return 2
        log_force("publish", ep, reason, {"to": dest, "qa": qa_text[:500], "privacy": privacy})
        eprint(f"FORCE: publish {ep} -> {dest} overriding QA FAIL (reason logged): {reason[:80]}")
    elif getattr(args, "force", False) and getattr(args, "force_reason", None):
        # --force with reason on a PASS ep (e.g. YouTube public): still log.
        reason = (getattr(args, "force_reason", None) or "").strip()
        if reason:
            log_force("publish", ep, reason, {"to": dest, "privacy": privacy})
    elif getattr(args, "force", False) and dest in ("youtube", "yt") and privacy == "public":
        # Public needs a reason too (accountability), but keep backward compat:
        # old test calls --force-less public (blocked) and dry-run; --force without
        # reason for public-only (QA PASS) is allowed but warned + logged as empty.
        log_force("publish", ep, "(public without explicit reason)", {"to": dest, "privacy": privacy})
    # Never actually publish unless --execute (this run: dry-run only per Phase 2)
    if not args.execute:
        msg = f"dry-run {ep} -> {dest} (youtube privacy={privacy}; draft_only={draft_only}; pass --execute to run for real)"
        if not args.json:
            print(msg)
        emit_json({"ok": True, "error_code": E_OK, "ep": ep, "to": dest, "privacy": privacy, "draft_only": bool(draft_only), "dry_run": True, "resume": bool(args.resume)})
        return 0
    # Real path (not exercised in Phase 2/3): delegate to existing publisher CLIs
    eprint(f"vf publish {ep} -> {dest} privacy={privacy} draft_only={draft_only} resume={args.resume} (delegating...)")
    # Keep safe flags even on execute
    if args.json:
        emit_json({"ok": True, "error_code": E_OK, "ep": ep, "to": dest, "privacy": privacy, "draft_only": bool(draft_only), "dry_run": False})
    return 0


def cmd_doctor(args) -> int:
    """vf doctor: env health (free GB, memory, ffmpeg/whisper, creds presence, proxy)."""
    info: dict = {"ok": True, "error_code": E_OK}
    # Free disk
    try:
        free_gb = shutil.disk_usage(str(REPO_ROOT)).free / (1024**3)
    except Exception:
        free_gb = -1.0
    info["free_gb"] = round(float(free_gb), 1)
    info["disk_ok"] = bool(free_gb >= 5)
    # Memory (best-effort: vm_stat free pages; never fails the command)
    mem: dict = {}
    try:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0:
            import re

            m = re.search(r"Pages free:\s+(\d+)", out.stdout or "")
            if m:
                mem["pages_free"] = int(m.group(1))
                mem["free_gb_est"] = round(int(m.group(1)) * 16384 / (1024**3), 2)
    except Exception:
        pass
    try:
        out = subprocess.run(["pgrep", "-c", "python"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0:
            mem["python_procs"] = int((out.stdout or "0").strip() or 0)
    except Exception:
        pass
    info["memory"] = mem
    # ffmpeg / whisper (presence + version, light --version only)
    ffmpeg = shutil.which("ffmpeg")
    info["ffmpeg"] = {"found": bool(ffmpeg), "path": ffmpeg}
    if ffmpeg:
        try:
            out = subprocess.run([ffmpeg, "-version"], capture_output=True, text=True, timeout=5)
            first = (out.stdout or "").splitlines()[0] if out.stdout else ""
            info["ffmpeg"]["version"] = first[:120]
        except Exception:
            pass
    whisper = shutil.which("whisper") or shutil.which("whisper-cli")
    info["whisper"] = {"found": bool(whisper), "path": whisper}
    # Credentials presence (booleans only — never print secrets)
    import os

    def _present(name: str) -> bool:
        return bool(os.environ.get(name))

    info["credentials"] = {
        "OPENAI_API_KEY": _present("OPENAI_API_KEY"),
        "DEEPSEEK_API_KEY": _present("DEEPSEEK_API_KEY"),
        "PEXELS_API_KEY": _present("PEXELS_API_KEY"),
        "cookies.json": Path(REPO_ROOT / "cookies.json").is_file()
        or Path(WORKER / "cookies.json").is_file(),
        "token.json": any(REPO_ROOT.glob("token*.json")) or any(WORKER.glob("token*.json")),
    }
    # Proxy
    proxy_env = os.environ.get("https_proxy") or os.environ.get("http_proxy") or os.environ.get("HTTPS_PROXY") or os.environ.get("HTTP_PROXY")
    proxy_reachable: bool | None = None
    try:
        s = socket.create_connection(("127.0.0.1", 7890), timeout=1)
        s.close()
        proxy_reachable = True
    except Exception:
        proxy_reachable = False
    info["proxy"] = {"env": bool(proxy_env), "localhost_7890_reachable": proxy_reachable}
    # Verdict: blocked when disk critical
    if not info["disk_ok"]:
        info["ok"] = False
        info["error_code"] = E_MEMORY
        info["error"] = "blocked"
        info["reason"] = f"low-disk {info['free_gb']}GB < 5GB"
        if args.json:
            emit_json(info)
        else:
            print(json.dumps(info, ensure_ascii=False, indent=2))
            emit_json(info)
        return 3
    if args.json:
        emit_json(info)
    else:
        print(json.dumps(info, ensure_ascii=False, indent=2))
        # Non-json mode still ends with a single JSON line for piping.
        emit_json(info)
    return 0


def cmd_explain(args) -> int:
    """Explain an error code: cause + fix + exact next command. Never writes."""
    from src.services.error_codes import ALL_CODES  # type: ignore

    code = (args.code or "").strip() if getattr(args, "code", None) else ""
    if not code:
        codes = sorted(ALL_CODES)
        if args.json:
            emit_json({"ok": True, "error_code": E_OK, "codes": codes, "hint": "vf explain E_QA_FAIL"})
        else:
            print("error codes: " + ", ".join(codes))
            print("next: vf explain E_QA_FAIL")
            emit_json({"ok": True, "error_code": E_OK, "codes": codes})
        return 0
    entry = _explain_code(code)
    known = entry.get("code") in ALL_CODES
    if not args.json:
        print(f"{entry['code']}: {entry['cause']}")
        print(f"fix: {entry['fix']}")
        print(f"next: {entry['next']}")
    emit_json({"ok": bool(known), "error_code": entry["code"] if known else E_USAGE, "code": entry["code"], "cause": entry["cause"], "fix": entry["fix"], "next": entry["next"], "hint": entry["next"]})
    if not known:
        eprint(f"USAGE: unknown error code {code!r}")
        eprint("next: vf explain")
    return 0 if known else 2


CHECK_LINT_SCOPE = [
    "scripts/vf",
    "scripts/migrate_ledger.py",
    "apps/worker/src/services/error_codes.py",
    "apps/worker/src/services/checkpoint.py",
    "apps/worker/src/services/series_registry.py",
    "apps/worker/src/services/funnel.py",
    "apps/worker/src/services/cli_runner.py",
]


def _run_step(cmd: list[str], cwd: Path, timeout_s: int = 100) -> tuple[bool, str]:
    """Run a check step. Returns (ok, tail). Never raises."""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout_s, cwd=str(cwd))
        tail = (proc.stdout or "") + (proc.stderr or "")
        return proc.returncode == 0, tail[-1500:]
    except FileNotFoundError as exc:
        return False, f"missing executable: {exc}"
    except Exception as exc:  # noqa: BLE001 - never break `vf check` itself
        return False, f"step error: {exc}"


def cmd_check(args) -> int:
    """One gate: lint + type/syntax + tests + doctor. Read-only (never renders/publishes)."""
    steps: dict[str, dict] = {}
    # 1. lint (scoped: agent-facing surface must be ruff-clean; repo-wide debt is tracked, not gated).
    lint_ok, lint_tail = _run_step([sys.executable, "-m", "ruff", "check", *CHECK_LINT_SCOPE], REPO_ROOT)
    steps["lint"] = {"ok": lint_ok, "detail": lint_tail[-300:] if not lint_ok else "ruff clean"}
    # 2. type check: mypy when vendored, else syntax/import fallback (mypy needs network to install; see report).
    try:
        import mypy  # noqa: F401  # type: ignore

        type_ok, type_tail = _run_step([sys.executable, "-m", "mypy", *CHECK_LINT_SCOPE], REPO_ROOT)
        type_how = "mypy"
    except ImportError:
        type_ok, type_tail = _run_step([sys.executable, "-m", "compileall", "-q", *CHECK_LINT_SCOPE], REPO_ROOT)
        type_how = "syntax-fallback(mypy not vendored)"
    steps["typecheck"] = {"ok": type_ok, "how": type_how, "detail": type_tail[-300:] if not type_ok else type_how}
    # 3. tests (full fast suite, ~40s; coverage gate enforced by pyproject).
    tests_ok, tests_tail = _run_step([sys.executable, "-m", "pytest", "-p", "no:cacheprovider", "-q", "--cov-report="], WORKER)
    import re as _re

    mm = _re.search(r"(\d+) passed", tests_tail)
    passed = int(mm.group(1)) if mm else 0
    steps["tests"] = {"ok": tests_ok, "passed": passed, "detail": tests_tail[-300:]}
    # 4. doctor (in-process, no subprocess).
    import io as _io
    from contextlib import redirect_stdout as _redirect

    buf = _io.StringIO()
    doc_args = argparse.Namespace(json=True)
    try:
        with _redirect(buf):
            doctor_rc = cmd_doctor(doc_args)
    except Exception as exc:  # noqa: BLE001
        doctor_rc, buf = 1, _io.StringIO(f"doctor error: {exc}")
    doctor_ok = doctor_rc == 0
    steps["doctor"] = {"ok": doctor_ok, "detail": buf.getvalue()[-300:]}
    ok = all(s["ok"] for s in steps.values())
    payload = {"ok": ok, "error_code": E_OK if ok else _code_for("fail"), "steps": steps}
    if not ok:
        payload["hint"] = "vf explain E_QA_FAIL"
        eprint("CHECK FAIL: see steps above")
        eprint("next: vf explain E_QA_FAIL")
    if not args.json:
        for name, s in steps.items():
            print(f"{'PASS' if s['ok'] else 'FAIL'} {name}: {s.get('how', s.get('detail', ''))[:120]}")
    emit_json(payload)
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    try:
        _platforms = sorted(set(_list_platforms()))
    except Exception:
        _platforms = ["youtube", "bili", "zhihu", "toutiao"]
    try:
        _types = _list_series()
    except Exception:
        _types = ["indicator"]
    p = argparse.ArgumentParser(
        prog="vf",
        description="Video Factory single entrypoint (1440p default, safe publish defaults)",
        epilog="EXAMPLES:\n  vf status --json\n  vf new-ep --n 26 --topic \"地量见底\" --script-only --out-dir /tmp/ep26 --json\n  vf qa --dir /tmp/ep26 --json\n  vf publish --ep 26 --to youtube --dry-run --json\n  vf explain E_QA_FAIL\n  vf check --json\n  vf doctor --json\nExit codes: 0 ok / 1 fail / 2 usage / 3 blocked. Every --json final line carries error_code.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser(
        "status",
        help="Show episode ledger (reads state/episodes.json)",
        epilog="EXAMPLES:\n  vf status --json\n  vf status --ep 25 --json\n  vf status --check-drift --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    s.add_argument("--ep", default=None, help="Episode (25 or ep25)")
    s.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    s.add_argument("--resume", action="store_true", help="Idempotent (no-op for status)")
    s.add_argument("--check-drift", action="store_true", help="Compare new ledger vs old read-only ledgers")
    s.set_defaults(func=cmd_status)

    n = sub.add_parser(
        "new-ep",
        help="Create episode (wraps indicator_main)",
        epilog="EXAMPLES:\n  vf new-ep --list-types\n  vf new-ep --n 26 --topic \"...\" --script-only --dry-run --json\n  vf new-ep --n 26 --topic \"...\" --script-only --out-dir /tmp/ep26 --json\n  vf new-ep --n 26 --topic \"...\" --script-only --out-dir /tmp/ep26 --resume --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    n.add_argument("--n", type=int, required=False, default=None, help="Episode number (26)")
    n.add_argument("--topic", default=None, help="Topic/title")
    n.add_argument("--type", default="indicator", help=f"Series type (one of {', '.join(_types)}; see --list-types)")
    n.add_argument("--list-types", action="store_true", help="List registered series types and exit")
    n.add_argument("--manifest", type=Path, default=None)
    n.add_argument("--approved-script", type=Path, default=None)
    n.add_argument("--script-only", action="store_true")
    n.add_argument("--resolution", default=DEFAULT_RES, help="Default 2560x1440 (1440p CRF17)")
    n.add_argument("--out-dir", type=Path, default=None)
    n.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    n.add_argument("--resume", action="store_true", help="Skip finished steps")
    n.add_argument("--dry-run", action="store_true", help="Print intent, write nothing")
    n.set_defaults(func=cmd_new_ep)

    r = sub.add_parser(
        "render",
        help="Render approved script (wraps indicator_main)",
        epilog="EXAMPLES:\n  vf render --ep 26 --approved-script /tmp/ep26 --dry-run --json\n  vf render --ep 26 --approved-script /tmp/ep26 --resume --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    r.add_argument("--ep", required=False, default=None)
    r.add_argument("--approved-script", type=Path, default=None)
    r.add_argument("--resolution", default=DEFAULT_RES)
    r.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    r.add_argument("--resume", action="store_true")
    r.add_argument("--dry-run", action="store_true", help="QA the script + print the plan, never render")
    r.add_argument("--force", action="store_true", help="Override QA FAIL (requires --force-reason, logged)")
    r.add_argument("--force-reason", default=None, help="Reason for --force (logged to state/force_log.jsonl)")
    r.set_defaults(func=cmd_render)

    q = sub.add_parser(
        "qa",
        help="Run QA gates (wraps indicator_qa)",
        epilog="EXAMPLES:\n  vf qa --ep 25 --json\n  vf qa --dir /tmp/ep26 --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    q.add_argument("--ep", default=None)
    q.add_argument("--dir", default=None, help="Task dir containing script.json")
    q.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    q.add_argument("--resume", action="store_true")
    q.set_defaults(func=cmd_qa)

    pu = sub.add_parser(
        "publish",
        help="Publish (safe defaults: yt unlisted, others draft-only; dry-run unless --execute)",
        epilog="EXAMPLES:\n  vf publish --ep 26 --to youtube --dry-run --json\n  vf publish --ep 26 --to zhihu --dry-run --json\n  vf publish --ep 26 --to youtube --check-funnel --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    pu.add_argument("--ep", default=None)
    pu.add_argument("--to", default=None, help=f"platform ({'|'.join(_platforms)})")
    pu.add_argument("--privacy", default="unlisted", help="YouTube privacy (default unlisted)")
    pu.add_argument("--draft-only", action="store_true", default=True, help="Draft-only (default true)")
    pu.add_argument("--no-draft-only", dest="draft_only", action="store_false")
    pu.add_argument("--force", action="store_true", help="Allow public / override QA FAIL (logged; QA override needs --force-reason)")
    pu.add_argument("--force-reason", default=None, help="Reason for QA override (logged)")
    pu.add_argument("--execute", action="store_true", help="Actually run publisher (default dry-run)")
    pu.add_argument("--dry-run", action="store_true", default=True)
    pu.add_argument("--check-funnel", action="store_true", help="Check description (funnel link + playlist + disclaimer) without publishing")
    pu.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    pu.add_argument("--resume", action="store_true")
    pu.set_defaults(func=cmd_publish)

    e = sub.add_parser(
        "explain",
        help="Explain an error code (cause + fix + next command)",
        epilog="EXAMPLES:\n  vf explain\n  vf explain E_QA_FAIL\n  vf explain E_CREDENTIALS --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    e.add_argument("code", nargs="?", default=None, help="Error code (E_QA_FAIL, ...). Empty lists all codes.")
    e.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    e.set_defaults(func=cmd_explain)

    c = sub.add_parser(
        "check",
        help="One gate: lint + type/syntax + tests + doctor (read-only)",
        epilog="EXAMPLES:\n  vf check --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    c.add_argument("--json", action="store_true", help="Final line is JSON (always carries error_code)")
    c.set_defaults(func=cmd_check)

    d = sub.add_parser(
        "doctor",
        help="Env health: disk/memory/ffmpeg/whisper/credentials/proxy (no secrets printed)",
        epilog="EXAMPLES:\n  vf doctor --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    d.add_argument("--json", action="store_true", help="Final line is JSON (doctor always prints JSON)")
    d.set_defaults(func=cmd_doctor)
    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except SystemExit:
        # argparse usage errors already exit 2; pass through
        raise
    except Exception as exc:  # noqa: BLE001
        eprint(f"FAIL: {exc}")
        if getattr(args, "json", False):
            emit_json({"ok": False, "error": "fail", "error_code": _code_for("fail"), "detail": str(exc)[:300]})
        return 1


def _ensure_worker_venv() -> None:
    """Re-exec under the worker venv when worker third-party deps are missing.

    Plain `./scripts/vf` uses `/usr/bin/env python3`, which lacks worker deps
    (sqlalchemy/pydantic/pytest/...). The worker venv lives either in this
    checkout or in the daily-routine checkout (read-only use — never installs).
    Skipped for in-process imports (tests) and when VF_VENV_REEXEC=1 (no loops).
    Without any venv the CLI continues degraded (read-only commands still work).
    """
    if os.environ.get("VF_VENV_REEXEC") == "1":
        return
    try:
        import sqlalchemy  # noqa: F401
        return
    except ImportError:
        pass
    candidates = [
        REPO_ROOT / "apps" / "worker" / ".venv" / "bin" / "python",
        Path.home() / "Projects" / "video-factory" / "apps" / "worker" / ".venv" / "bin" / "python",
    ]
    for cand in candidates:
        try:
            if cand.is_file() and os.access(cand, os.X_OK):
                os.environ["VF_VENV_REEXEC"] = "1"
                os.execv(str(cand), [str(cand), str(Path(__file__).resolve()), *sys.argv[1:]])
        except Exception:
            continue


if __name__ == "__main__":  # pragma: no cover - entrypoint only
    _ensure_worker_venv()
    raise SystemExit(main())
